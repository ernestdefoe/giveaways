{
    "name": "ernestdefoe/giveaways",
    "description": "Run provably-fair giveaways and raffles on your Flarum 2 forum — earn-entries engine, scheduled auto-draws, winner notifications.",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": [
        "flarum",
        "extension",
        "giveaway",
        "raffle",
        "contest",
        "sweepstakes"
    ],
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39385-giveaways",
        "issues": "https://github.com/ernestdefoe/giveaways/issues",
        "source": "https://github.com/ernestdefoe/giveaways"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "ernestdefoe/festoon": "Advent calendars open their doors at Festoon's midnight.",
        "ernestdefoe/secret-santa": "An advent door can feature a Secret Santa exchange.",
        "fof/upload": "Pick a giveaway's cover image from the media library.",
        "flarum/approval": "A giveaway added in the composer goes public when its post is approved.",
        "ernestdefoe/bespoke": "A widget host for the \"Today's door\" advent calendar widget.",
        "fof/forum-widgets-core": "A widget host for the \"Today's door\" advent calendar widget.",
        "flarum/gdpr": "Members' sponsor consents are included in their data export and erased with their account."
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Giveaways\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Giveaways\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Giveaways",
            "category": "feature",
            "icon": {
                "name": "fas fa-gift",
                "backgroundColor": "#69c6b9",
                "color": "#1A2744"
            },
            "optional-dependencies": [
                "flarum/approval",
                "fof/upload",
                "ernestdefoe/festoon",
                "ernestdefoe/secret-santa",
                "ernestdefoe/bespoke",
                "fof/forum-widgets-core",
                "flarum/gdpr"
            ]
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "ernestdefoe/festoon": "^1.4",
        "ernestdefoe/secret-santa": "^1.0",
        "flarum/gdpr": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
